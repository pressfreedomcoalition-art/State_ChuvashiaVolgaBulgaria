[Unit]
Description=CHV State Telegram bot (@bulgaria_state_bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/chv-bot
EnvironmentFile=-/opt/chv-bot/.env
ExecStart=/usr/bin/node /opt/chv-bot/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
